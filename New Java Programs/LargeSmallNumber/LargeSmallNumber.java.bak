
		int large = (num1>num2)?((num1>num3)?(num1):((num3>num4)?(num3):(num4))):((num2>num3)?(num2):((num3>num4)?(num3):(num4)));

		//int large =(num1>num2)?((num1>num3)?(num1):(num3)):((num2>num3)?(num2):(num3));
		//int small =(num1<num2)?((num1<num3)?(num1):(num3)):((num2<num3)?(num2):(num3));


		System.out.println("Larger number is: "+large);
		//System.out.println("Smaller number is: "+small);


	}
}
